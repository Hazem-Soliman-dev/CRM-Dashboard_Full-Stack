{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install --workspaces --include-workspace-root",
  "framework": null,
  "routes": [
    {
      "src": "/api/v1/reports/(.*)",
      "dest": "backend/api/reports.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "backend/api/index.ts"
    },
    {
      "src": "/(.*\\.(js|css|ico|png|jpg|jpeg|svg|gif|woff|woff2|ttf|eot|json|webp))",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "backend/api/reports.ts": {
      "runtime": "nodejs",
      "memory": 1536,
      "maxDuration": 90,
      "includeFiles": [
        "backend/sqlite_schema.sql",
        "backend/migrations/*.sql"
      ]
    },
    "backend/api/**/*.ts": {
      "runtime": "nodejs",
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": [
        "backend/sqlite_schema.sql",
        "backend/migrations/*.sql"
      ]
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}